NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Optional: email notifications to students (returned for fixes / graded) over SMTP.
# Leave unset to disable; the teacher then sees "email failed" and nothing is sent.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587            # 465 = implicit TLS, 587 = STARTTLS
# SMTP_USER=you@example.com
# SMTP_PASS=app-password
# SMTP_FROM="Course <you@example.com>"
# Automatic reminders (daily Vercel Cron, see vercel.json). Server-only secrets: never prefix with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=service_role_key   # Supabase > Project Settings > API
# CRON_SECRET=long-random-string               # Vercel sends it as a Bearer token to the cron route
# Optional: public URL used in sitemap.xml / robots.txt (Vercel production URL is used if unset)
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
